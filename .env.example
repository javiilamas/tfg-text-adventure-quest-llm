# Copia este archivo a .env y rellena tu clave.
# Clave de OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Modelo (debe soportar tool-calling)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Opcional: clave para firmar las cookies de sesion. Si no se define, la
# aplicacion genera una aleatoria en cada arranque.
# FLASK_SECRET=
# Opcional: 1 = registrar en la salida de web-app las herramientas que pide el modelo.
# DEBUG_LLM=1
